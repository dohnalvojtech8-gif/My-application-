generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model User {
 id String @id @default(uuid())
 username String @unique
 password String
 role String @default("USER")
 blocked Boolean @default(false)
 opening BigInt @default(0)
 preferences Json @default("{}")
 events Event[]
 sessions Session[]
 series Series[]
 notifications Notification[]
 subscriptions Subscription[]
 items Item[]
 entries Entry[]
}
model Bootstrap {
 id Int @id
}
model Session {
 token String @id
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 expires DateTime
}
model Invite {
 token String @id
 expires DateTime
 used Boolean @default(false)
}
model Item {
 id String @id @default(uuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 name String
 kind String
 color String @default("#14b8a6")
 deletedAt DateTime?
 hidden Boolean @default(false)
 appearance Json @default("{}")
 favorite Boolean @default(false)
 important Boolean @default(false)
 position Int @default(0)
 defaultAmount BigInt @default(0)
 entries Entry[]
 @@unique([id,userId])
}
model Entry {
 id String @id @default(uuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 itemId String
 item Item @relation(fields: [itemId,userId], references: [id,userId])
 amount BigInt
 date String
 status String
 comment String @default("")
 itemSnapshot Json?
 seriesId String?
 occurrence Int?
 key String
 @@unique([userId,key])
 @@index([userId,date])
}

model Series {
 id String @id @default(uuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 itemId String
 amount BigInt
 start String
 end String?
 count Int?
 frequency String
 interval Int @default(1)
 paused Boolean @default(false)
 comment String @default("")
 @@index([userId])
}
model Notification {
 id String @id @default(uuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 entryId String
 date String
 title String
 read Boolean @default(false)
 @@unique([userId,entryId,date])
}
model Subscription {
 id String @id @default(uuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 endpoint String @unique
 keys Json
}

model Event {
 id String @id @default(uuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 action String
 createdAt DateTime @default(now())
 @@index([userId,createdAt])
}
