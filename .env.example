DATABASE_URL=postgresql://postgres:postgres@localhost:5432/systematic_money
APP_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Set only when syncing native applications:
MOBILE_SERVER_URL=https://your-app.onrender.com

# Optional Enable Banking AIS integration. The same keys are needed by web and worker.
# No live bank access without an activated provider application and user consent.
BANK_PROVIDER_MODE=sandbox
BANK_APP_ID=
BANK_PRIVATE_KEY_FILE=
# Alternative to a secret file: PEM content in a server environment variable.
BANK_PRIVATE_KEY=
# Generate independently: openssl rand -hex 32. Back up securely with your database.
BANK_DATA_KEY=
BANK_REDIRECT_URL=https://your-app.onrender.com/bank/callback
