    "@capacitor/ios": "^8.6.0",
    "@prisma/client": "6.19.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/web-push": "^3.6.4",
    "ajv": "^8.20.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "helmet": "^8.1.0",
    "lucide-react": "^1.70.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
