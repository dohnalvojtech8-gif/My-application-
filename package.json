{
  "name": "finance-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch apps/api/server.ts",
    "build": "prisma generate && tsc --noEmit && vite build apps/web --outDir ../../dist/web",
    "start": "tsx apps/api/server.ts",
    "test": "vitest run",
    "migrate": "prisma migrate deploy",
    "worker": "tsx apps/api/worker.ts",
    "prestart": "npm run migrate"
  },
